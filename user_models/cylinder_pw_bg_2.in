#title: cylinder_pw_bg

#domain: 0.400 0.400 0.002
#dx_dy_dz: 0.002 0.002 0.002
#time_window: 4.5e-9

#waveform: ricker 1 1e9 pw_ricker

#python:
from gprMax.input_cmd_funcs import hertzian_dipole
dx = 0.002
x_src = 0.026
z_src = 0.001
y_start = 0.022
n_dip = 178
for i in range(n_dip):
    y = round(y_start + i * dx, 6)
    hertzian_dipole('z', x_src, y, z_src, 'pw_ricker')
#end_python:

## NO CYLINDER

