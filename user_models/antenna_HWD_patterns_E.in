#title: 3 GHz half-wavelength dipole antenna field patterns


#python:
import os
import numpy as np

from gprMax.input_cmd_funcs import *
from user_libs.antennas.wire_antennas import half_wavelength_dipole

filename = os.path.splitext(os.path.split(inputfile)[1])[0]

mm = 1e-3
cm = 1e-2
deg = np.pi/180
fHz = 3e9
c0 = 299792458

lam = c0/fHz

time_win = 3e-9
resolution = 2.5*mm
print('#dx_dy_dz: {} {} {}'.format(resolution,resolution,resolution))
print('#pml_cells: {}'.format(7))

timewindows = np.array([time_win]) # For 0.3m max
radii = np.linspace(10*cm, 30*cm, 3)
theta = np.linspace(3, 357, 60)
materials = ['2 0 1 0 er5'] # Can add more to list and use selector integer to choose
selector = 0

margin = 4*cm
domain = np.array( [2 * radii[-1] + margin, 
                    2 * radii[-1] + margin, 
                    2 * radii[-1] + margin] )
antennaposition = np.array([domain[0] / 2, domain[1] / 2, domain[2] / 2 ])

half_wavelength_dipole(antennaposition[0], antennaposition[1], antennaposition[2],
                       frequency=fHz, resolution=resolution)

print('#domain: {:.3f} {:.3f} {:.3f}'.format(domain[0], domain[1], domain[2]))
print('#time_window: {:.3e}'.format(timewindows[selector]))

## Can introduce soil model
#print('#soil_peplinski: 0.5 0.5 2.0 2.66 0.001 0.25 mySoil')
#print('#fractal_box: 0 0 0 {} {} {} 1.5 1 1 1 50 mySoil mySoilBox 1'.format(domain[0], domain[1], fs[2] + radii[-1]))

print('#material: {}'.format(materials[selector]))
print('#box: 0 0 0 {} {} {} {} n'.format(domain[0], domain[1], domain[2] / 2, materials[selector].split()[-1]))

## Save the position of the antenna to file for use when processing results
np.savetxt(os.path.join(os.path.dirname(inputfile), filename + '_rxsorigin.txt'), antennaposition, fmt="%f")

## Generate receiver points for pattern
for radius in range(len(radii)):
    ## E-plane circle (yz plane, x=0, phi=pi/2,3pi/2)
    x = radii[radius] * np.sin(theta * deg) * np.cos(90 * deg)
    y = radii[radius] * np.sin(theta * deg) * np.sin(90 * deg)
    z = radii[radius] * np.cos(theta * deg)
    for rxpt in range(len(theta)):
        print('#rx: {:.3f} {:.3f} {:.3f}'.format(x[rxpt] + antennaposition[0], y[rxpt] + antennaposition[1], z[rxpt] + antennaposition[2]))

# geometry_view(0, 0, 0, domain[0], domain[1], domain[2], 0.001, 0.001, 0.001, filename, 'n')
